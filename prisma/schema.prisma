generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum ProductType {
  SOFTWARE
  SERVICE
  PHYSICAL
  ADD_ON
}

enum BillingFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum DiscountApplicability {
  WHOLE_SUBSCRIPTION
  SPECIFIC_PRODUCTS
}

enum QuotationStatus {
  DRAFT
  SENT
  CONFIRMED
  EXPIRED
  CANCELLED
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CARD
  OTHER
}

// -----------------------------------------------------------------------------
// MEMBER 1: User & Authentication Models
// -----------------------------------------------------------------------------

model User {
  id             String               @id @default(uuid())
  email          String               @unique
  passwordHash   String
  name           String
  role           Role                 @default(CUSTOMER)
  phone          String?
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  customerProfile   CustomerProfile?
  resetTokens       PasswordResetToken[]
  recordedPayments  Payment[]            @relation("PaymentRecorder")
  statusChanges     SubscriptionStatusHistory[]

  @@index([email])
  @@index([role])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([userId])
}

model CustomerProfile {
  id           String         @id @default(uuid())
  userId       String         @unique
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName  String?
  address      String?
  city         String?
  state        String?
  zipCode      String?
  country      String?        @default("India")
  taxId        String?
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  quotations    Quotation[]
  subscriptions Subscription[]
  invoices      Invoice[]
  payments      Payment[]
  discountUsages DiscountUsage[]

  @@index([userId])
}

// -----------------------------------------------------------------------------
// MEMBER 2: Products, Variants, Plans, Taxes, Discounts
// -----------------------------------------------------------------------------

model Product {
  id          String         @id @default(uuid())
  name        String
  type        ProductType    @default(SOFTWARE)
  salesPrice  Decimal        @db.Decimal(10, 2)
  costPrice   Decimal        @db.Decimal(10, 2)
  notes       String?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  variants               ProductVariant[]
  plans                  SubscriptionPlan[]
  planProducts           PlanProduct[]
  quotationLines         QuotationLine[]
  subscriptionLines      SubscriptionLine[]
  invoiceLines           InvoiceLine[]
  discountProducts       DiscountProduct[]
  quotationTemplateLines QuotationTemplateLine[]

  @@index([name])
  @@index([isActive])
}

model ProductVariant {
  id            String   @id @default(uuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String   // e.g. "Basic", "Premium", "Enterprise", "Odoo Brand"
  priceModifier Decimal  @default(0.00) @db.Decimal(10, 2) // e.g. +560.00 for Odoo Brand
  sku           String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  quotationLines         QuotationLine[]
  subscriptionLines      SubscriptionLine[]
  quotationTemplateLines QuotationTemplateLine[]

  @@index([productId])
}

model SubscriptionPlan {
  id                  String           @id @default(uuid())
  name                String
  description         String?
  productId           String
  product             Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  billingFrequency    BillingFrequency @default(MONTHLY)
  minQuantity         Int              @default(1)
  basePrice           Decimal          @db.Decimal(10, 2)
  availableFrom       DateTime         @default(now())
  availableUntil      DateTime?
  autoClose           Boolean          @default(false)
  earlyClosureAllowed Boolean          @default(true)
  pauseAllowed        Boolean          @default(true)
  renewalAllowed      Boolean          @default(true)
  isActive            Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  planProducts       PlanProduct[]
  quotationTemplates QuotationTemplate[]
  quotations         Quotation[]
  subscriptions      Subscription[]

  @@index([productId])
  @@index([isActive])
  @@index([billingFrequency])
}

model PlanProduct {
  id              String           @id @default(uuid())
  planId          String
  plan            SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  productId       String
  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  defaultQuantity Int              @default(1)

  @@unique([planId, productId])
  @@index([planId])
  @@index([productId])
}

model Tax {
  id          String   @id @default(uuid())
  name        String   // e.g. "GST 18%", "VAT 5%"
  rate        Decimal  @db.Decimal(5, 2) // e.g. 18.00
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quotationLines    QuotationLine[]
  subscriptionLines SubscriptionLine[]
  invoiceLines      InvoiceLine[]

  @@index([isActive])
}

model Discount {
  id                 String                @id @default(uuid())
  code               String                @unique
  description        String?
  type               DiscountType          @default(PERCENTAGE)
  value              Decimal               @db.Decimal(10, 2) // e.g. 15.00 for 15% or 500 for fixed
  minPurchaseAmount  Decimal?              @db.Decimal(10, 2)
  minQuantity        Int?
  startDate          DateTime              @default(now())
  endDate            DateTime?
  maxUsageCount      Int?
  currentUsageCount  Int                   @default(0)
  applicableTo       DiscountApplicability @default(WHOLE_SUBSCRIPTION)
  isActive           Boolean               @default(true)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  discountProducts DiscountProduct[]
  discountUsages   DiscountUsage[]

  @@index([code])
  @@index([isActive])
}

model DiscountProduct {
  id         String   @id @default(uuid())
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([discountId, productId])
  @@index([discountId])
}

model DiscountUsage {
  id             String          @id @default(uuid())
  discountId     String
  discount       Discount        @relation(fields: [discountId], references: [id], onDelete: Cascade)
  customerId     String
  customer       CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subscriptionId String?
  invoiceId      String?
  usedAt         DateTime        @default(now())

  @@index([discountId])
  @@index([customerId])
}

// -----------------------------------------------------------------------------
// MEMBER 3: Quotations & Subscriptions Lifecycle
// -----------------------------------------------------------------------------

model QuotationTemplate {
  id           String            @id @default(uuid())
  name         String
  description  String?
  planId       String?
  plan         SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  validityDays Int               @default(30)
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  lines QuotationTemplateLine[]

  @@index([isActive])
}

model QuotationTemplateLine {
  id         String             @id @default(uuid())
  templateId String
  template   QuotationTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  productId  String
  product    Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId  String?
  variant    ProductVariant?    @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity   Int                @default(1)
  unitPrice  Decimal            @db.Decimal(10, 2)

  @@index([templateId])
}

model Quotation {
  id              String          @id @default(uuid())
  quotationNumber String          @unique // e.g. "QUO-2026-0001"
  customerId      String
  customer        CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Restrict)
  planId          String
  plan            SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  status          QuotationStatus @default(DRAFT)
  validityDate    DateTime
  subtotal        Decimal         @default(0.00) @db.Decimal(10, 2)
  taxAmount       Decimal         @default(0.00) @db.Decimal(10, 2)
  discountAmount  Decimal         @default(0.00) @db.Decimal(10, 2)
  totalAmount     Decimal         @default(0.00) @db.Decimal(10, 2)
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  lines         QuotationLine[]
  subscriptions Subscription[]

  @@index([quotationNumber])
  @@index([customerId])
  @@index([status])
}

model QuotationLine {
  id             String          @id @default(uuid())
  quotationId    String
  quotation      Quotation       @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  description    String?
  quantity       Int             @default(1)
  unitPrice      Decimal         @db.Decimal(10, 2)
  taxId          String?
  tax            Tax?            @relation(fields: [taxId], references: [id], onDelete: SetNull)
  taxAmount      Decimal         @default(0.00) @db.Decimal(10, 2)
  discountAmount Decimal         @default(0.00) @db.Decimal(10, 2)
  total          Decimal         @db.Decimal(10, 2)

  @@index([quotationId])
}

model Subscription {
  id                  String             @id @default(uuid())
  subscriptionNumber  String             @unique // e.g. "SUB-2026-0001"
  customerId          String
  customer            CustomerProfile    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  planId              String
  plan                SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  quotationId         String?
  quotation           Quotation?         @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  status              SubscriptionStatus @default(DRAFT)
  startDate           DateTime           @default(now())
  expiryDate          DateTime?
  billingFrequency    BillingFrequency   @default(MONTHLY)
  nextBillingDate     DateTime?
  autoClose           Boolean            @default(false)
  earlyClosureAllowed Boolean            @default(true)
  pauseAllowed        Boolean            @default(true)
  renewalAllowed      Boolean            @default(true)
  paymentTerms        String?            @default("Net 15")
  subtotal            Decimal            @default(0.00) @db.Decimal(10, 2)
  taxAmount           Decimal            @default(0.00) @db.Decimal(10, 2)
  discountAmount      Decimal            @default(0.00) @db.Decimal(10, 2)
  totalAmount         Decimal            @default(0.00) @db.Decimal(10, 2)
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  lines         SubscriptionLine[]
  statusHistory SubscriptionStatusHistory[]
  invoices      Invoice[]

  @@index([subscriptionNumber])
  @@index([customerId])
  @@index([status])
  @@index([nextBillingDate])
}

model SubscriptionLine {
  id             String          @id @default(uuid())
  subscriptionId String
  subscription   Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  description    String?
  quantity       Int             @default(1)
  unitPrice      Decimal         @db.Decimal(10, 2)
  taxId          String?
  tax            Tax?            @relation(fields: [taxId], references: [id], onDelete: SetNull)
  taxAmount      Decimal         @default(0.00) @db.Decimal(10, 2)
  discountAmount Decimal         @default(0.00) @db.Decimal(10, 2)
  total          Decimal         @db.Decimal(10, 2)

  @@index([subscriptionId])
}

model SubscriptionStatusHistory {
  id             String             @id @default(uuid())
  subscriptionId String
  subscription   Subscription       @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  previousStatus SubscriptionStatus
  newStatus      SubscriptionStatus
  changedByUserId String?
  changedByUser  User?              @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)
  changeReason   String?
  createdAt      DateTime           @default(now())

  @@index([subscriptionId])
}

// -----------------------------------------------------------------------------
// MEMBER 4: Billing, Invoices, Payments, Financial Tracking
// -----------------------------------------------------------------------------

model Invoice {
  id                 String          @id @default(uuid())
  invoiceNumber      String          @unique // e.g. "INV-2026-0001"
  subscriptionId     String?
  subscription       Subscription?   @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  customerId         String
  customer           CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status             InvoiceStatus   @default(DRAFT)
  invoiceDate        DateTime        @default(now())
  dueDate            DateTime
  billingPeriodStart DateTime?
  billingPeriodEnd   DateTime?
  billingPeriodKey   String?         @unique // unique idempotency key per sub+period e.g. "SUB-001_2026-10"
  subtotal           Decimal         @default(0.00) @db.Decimal(10, 2)
  taxAmount          Decimal         @default(0.00) @db.Decimal(10, 2)
  discountAmount     Decimal         @default(0.00) @db.Decimal(10, 2)
  totalAmount        Decimal         @default(0.00) @db.Decimal(10, 2)
  amountPaid         Decimal         @default(0.00) @db.Decimal(10, 2)
  balance            Decimal         @default(0.00) @db.Decimal(10, 2)
  notes              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  lines    InvoiceLine[]
  payments Payment[]

  @@index([invoiceNumber])
  @@index([customerId])
  @@index([subscriptionId])
  @@index([status])
  @@index([dueDate])
}

model InvoiceLine {
  id             String          @id @default(uuid())
  invoiceId      String
  invoice        Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  description    String
  quantity       Int             @default(1)
  unitPrice      Decimal         @db.Decimal(10, 2)
  taxId          String?
  tax            Tax?            @relation(fields: [taxId], references: [id], onDelete: SetNull)
  taxAmount      Decimal         @default(0.00) @db.Decimal(10, 2)
  discountAmount Decimal         @default(0.00) @db.Decimal(10, 2)
  total          Decimal         @db.Decimal(10, 2)

  @@index([invoiceId])
}

model Payment {
  id               String          @id @default(uuid())
  paymentReference String          @unique // e.g. "PAY-2026-0001"
  invoiceId        String
  invoice          Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  customerId       String
  customer         CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Restrict)
  amount           Decimal         @db.Decimal(10, 2)
  paymentMethod    PaymentMethod   @default(BANK_TRANSFER)
  paymentDate      DateTime        @default(now())
  notes            String?
  recordedByUserId String?
  recordedByUser   User?           @relation("PaymentRecorder", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([paymentReference])
  @@index([invoiceId])
  @@index([customerId])
  @@index([paymentDate])
}
