# Server Configuration
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000/api/v1
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL)
# Default connection for local PostgreSQL or Docker Compose
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/brightloop_subscriptions?schema=public"

# JWT Authentication
JWT_SECRET="brightloop_super_secure_jwt_secret_key_2026_odoo_hackathon"
JWT_EXPIRES_IN="7d"

# Password Reset Token
RESET_TOKEN_EXPIRES_MINUTES=60

# Email Delivery (Nodemailer - Configurable)
# In development, tokens are also returned in dev mode or logged to console
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Brightloop Software <no-reply@brightloop.io>"

# Cron Schedule for Recurring Billing
# Default: Every day at midnight "0 0 * * *" or every minute for testing "* * * * *"
BILLING_CRON_SCHEDULE="0 0 * * *"
